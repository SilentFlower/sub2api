COMPOSE_PROJECT_NAME=sub2api-ha-export
SOCAT_IMAGE=alpine/socat@sha256:beb4a68d9e4fe6b0f21ea774a0fde6c31f580dde6368939ed70100c5385b015e
EXPORT_BIND_HOST=0.0.0.0
POSTGRES_EXPORT_PORT=15432
REDIS_EXPORT_PORT=16379
B_SOURCE_CIDR=REPLACE_WITH_B_PUBLIC_IP/32
POSTGRES_REPLICATION_USER=sub2api_replica
POSTGRES_REPLICATION_SLOT=sub2api_b_standby
WAL_KEEP_SIZE=2GB
MAX_SLOT_WAL_KEEP_SIZE=8GB

# A 修复回切使用原 deploy Compose，并通过覆盖文件切换到新恢复卷
PRIMARY_PROJECT_NAME=deploy
PRIMARY_COMPOSE_FILE=/root/sub2api/deploy/docker-compose.yml
PRIMARY_ENV_FILE=/root/sub2api/deploy/.env
SUB2API_IMAGE=ghcr.io/silentflower/sub2api@sha256:ff1bd8e6494963642570706d0ab55e04a1a15d9fd79707fc555d0f844f357d52
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
A_RECOVERY_APP_VOLUME=sub2api-ha-app-data
A_RECOVERY_POSTGRES_VOLUME=sub2api-ha-postgres-data
A_RECOVERY_REDIS_VOLUME=sub2api-ha-redis-data

# B 远程控制与临时恢复出口
B_SSH_TARGET=REPLACE_WITH_B_SSH_TARGET
B_SSH_IDENTITY_FILE=/root/.ssh/sub2api_dr_ed25519
B_DR_ROOT=/root/sub2api-dr
B_REPLICATION_HOST=REPLACE_WITH_B_FIXED_IP_OR_HOST
B_POSTGRES_RECOVERY_PORT=25432
B_REDIS_RECOVERY_PORT=26379
POSTGRES_A_RECOVERY_SLOT=sub2api_a_recovery
SSH_CONNECT_TIMEOUT=10
