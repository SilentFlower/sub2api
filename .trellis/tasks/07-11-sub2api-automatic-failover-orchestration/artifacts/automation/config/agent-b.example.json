{
  "node": "B",
  "control_url": "https://REPLACE_WITH_WORKER_DOMAIN",
  "secret_file": "/etc/sub2api-ha/node-secret",
  "state_command": [
    "/root/sub2api-dr/scripts/switch-mode.sh",
    "status",
    "--machine"
  ],
  "app_container": "sub2api-dr-app",
  "stop_app_command": ["docker", "stop", "sub2api-dr-app"],
  "start_app_command": ["docker", "start", "sub2api-dr-app"],
  "ensure_restart_policy_command": ["docker", "update", "--restart=no", "sub2api-dr-app"],
  "app_health_url": "http://127.0.0.1:18080/health",
  "public_health_url": "https://api.havefun.eu.cc/health",
  "tunnel_service": "cloudflared-sub2api-ha-b.service",
  "expected_restart_policy": "no",
  "actions": {
    "B_PROMOTING": {
      "command": ["/root/sub2api-dr/scripts/switch-mode.sh", "enable"],
      "stdin": "A_IS_STOPPED_AND_WILL_NOT_WRITE\n",
      "timeout_seconds": 1800,
      "enforce_restart_policy": true
    },
    "B_FREEZING": {
      "command": ["/root/sub2api-dr/scripts/switch-mode.sh", "freeze"],
      "stdin": "FREEZE_B_WRITES_FOR_CUTBACK\n",
      "timeout_seconds": 600
    }
  },
  "interval_seconds": 5,
  "request_timeout_seconds": 4,
  "command_timeout_seconds": 30,
  "public_health_timeout_seconds": 90,
  "lock_file": "/run/sub2api-ha-agent.lock",
  "checkpoint_file": "/var/lib/sub2api-ha-agent/checkpoint.json",
  "pending_alert_file": "/var/lib/sub2api-ha-agent/pending-alerts.json",
  "failback_stable_seconds": 1800,
  "failback_window_start": "04:00",
  "failback_window_end": "05:00"
}
