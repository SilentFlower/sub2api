# Compose 固定标识
COMPOSE_PROJECT_NAME=sub2api-dr
DR_BIND_HOST=0.0.0.0
DR_APP_PORT=18080
TZ=Asia/Shanghai

# 固定镜像
SUB2API_IMAGE=ghcr.io/silentflower/sub2api@sha256:ff1bd8e6494963642570706d0ab55e04a1a15d9fd79707fc555d0f844f357d52
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
SOCAT_IMAGE=alpine/socat@sha256:beb4a68d9e4fe6b0f21ea774a0fde6c31f580dde6368939ed70100c5385b015e

# PostgreSQL业务连接参数，建立复制时改为与 A 一致的真实值
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=REPLACE_WITH_A_POSTGRES_PASSWORD
POSTGRES_DB=sub2api

# PostgreSQL物理复制参数，阶段 2 在 A 创建后填写
A_REPLICATION_HOST=REPLACE_WITH_A_FIXED_IP
A_POSTGRES_REPLICATION_PORT=15432
POSTGRES_REPLICATION_USER=sub2api_replica
POSTGRES_REPLICATION_PASSWORD=REPLACE_WITH_REPLICATION_PASSWORD
POSTGRES_REPLICATION_SLOT=sub2api_b_standby
POSTGRES_A_RECOVERY_SLOT=sub2api_a_recovery

# Redis参数，建立复制时改为与 A 一致的真实值
REDIS_PASSWORD=REPLACE_WITH_A_REDIS_PASSWORD
REDIS_MASTER_PASSWORD=REPLACE_WITH_A_REDIS_PASSWORD
A_REDIS_REPLICATION_PORT=16379

# B 临时作为恢复源时使用，仅在 A 修复回切期间启动
RECOVERY_EXPORT_BIND_HOST=0.0.0.0
B_POSTGRES_RECOVERY_PORT=25432
B_REDIS_RECOVERY_PORT=26379
A_SOURCE_CIDR=REPLACE_WITH_A_PUBLIC_IP/32

# 应用运行参数。后续以 A 的实际 .env 为源生成真实文件
SERVER_MODE=release
RUN_MODE=standard
JWT_SECRET=REPLACE_WITH_A_JWT_SECRET
TOTP_ENCRYPTION_KEY=REPLACE_WITH_A_TOTP_ENCRYPTION_KEY
